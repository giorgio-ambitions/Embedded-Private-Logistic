#include "stm32f4xx_hal.h"

/* ============================
   Variabili globali autonome
   ============================ */
volatile uint8_t obstacle_detected = 0;
TIM_HandleTypeDef htim1;

/* ============================
   Inizializzazione sensore PA0
   ============================ */
void Sensor_Init(void)
{
    __HAL_RCC_GPIOA_CLK_ENABLE();
    __HAL_RCC_SYSCFG_CLK_ENABLE();

    GPIO_InitTypeDef cfg = {0};
    cfg.Pin = GPIO_PIN_0;               // Sensore su PA0
    cfg.Mode = GPIO_MODE_IT_RISING;     // Interrupt su fronte di salita
    cfg.Pull = GPIO_PULLDOWN;           // Sensore normalmente basso
    HAL_GPIO_Init(GPIOA, &cfg);

    HAL_NVIC_SetPriority(EXTI0_IRQn, 1, 0);
    HAL_NVIC_EnableIRQ(EXTI0_IRQn);
}

/* ============================
   Inizializzazione motore PWM
   ============================ */
void Motor_Init(void)
{
    __HAL_RCC_GPIOA_CLK_ENABLE();
    __HAL_RCC_TIM1_CLK_ENABLE();

    GPIO_InitTypeDef cfg = {0};
    cfg.Pin = GPIO_PIN_8;               // PA8 → TIM1_CH1
    cfg.Mode = GPIO_MODE_AF_PP;
    cfg.Pull = GPIO_NOPULL;
    cfg.Speed = GPIO_SPEED_HIGH;
    cfg.Alternate = GPIO_AF1_TIM1;
    HAL_GPIO_Init(GPIOA, &cfg);

    htim1.Instance = TIM1;
    htim1.Init.Prescaler = 84 - 1;      // 1 MHz
    htim1.Init.Period = 20000 - 1;      // 20 ms (servo / ESC)
    htim1.Init.CounterMode = TIM_COUNTERMODE_UP;
    HAL_TIM_PWM_Init(&htim1);

    TIM_OC_InitTypeDef oc = {0};
    oc.OCMode = TIM_OCMODE_PWM1;
    oc.Pulse = 1500;                    // 1.5 ms → neutro
    HAL_TIM_PWM_ConfigChannel(&htim1, &oc, TIM_CHANNEL_1);

    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
}

/* ============================
   Callback EXTI → percezione
   ============================ */
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if(GPIO_Pin == GPIO_PIN_0)
    {
        obstacle_detected = 1;          // Ostacolo rilevato
    }
}

/* ============================
   Logica autonoma
   ============================ */
void Autonomous_Update(void)
{
    if(obstacle_detected)
    {
        TIM1->CCR1 = 1000;              // Frena / sterza
        obstacle_detected = 0;
    }
    else
    {
        TIM1->CCR1 = 1600;              // Avanza
    }
}

/* ============================
   MAIN
   ============================ */
int main(void)
{
    HAL_Init();
    Sensor_Init();
    Motor_Init();

    while(1)
    {
        Autonomous_Update();
        HAL_Delay(10);                  // 100 Hz control loop
    }
}
